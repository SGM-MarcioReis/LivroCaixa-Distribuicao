@page "/entidade"
@using Microsoft.Data.Sqlite

<PageTitle>🏢 Entidade</PageTitle>

<div class="container-fluid px-3 py-3">
    <h4 class="text-center mb-4">🏢 Dados da Entidade</h4>

    <div class="form-card">
        <label class="form-label">Nome</label>
        <input class="form-control" @bind="entidade.Nome" />

        <label class="form-label">Nome Fantasia</label>
        <input class="form-control" @bind="entidade.NomeFantasia" />

        <label class="form-label">CNPJ</label>
        <input class="form-control" @bind="entidade.CNPJ" />

        <label class="form-label">Presidente</label>
        <input class="form-control" @bind="entidade.Presidente" />

        <label class="form-label">Tesoureiro</label>
        <input class="form-control" @bind="entidade.Tesoureiro" />

        <label class="form-label">Telefone</label>
        <input class="form-control" @bind="entidade.Telefone" />

        <label class="form-label">E-mail</label>
        <input class="form-control" @bind="entidade.Email" />

        <label class="form-label">Cidade</label>
        <input class="form-control" @bind="entidade.Cidade" />

        <button type="button" class="btn btn-azul mt-3" @onclick="Salvar">💾 Salvar Entidade</button>

        @if (!string.IsNullOrEmpty(mensagem))
        {
            <p style="color:green; text-align:center; margin-top:10px;">@mensagem</p>
        }
    </div>
</div>

@code {
    private Entidade entidade = new();
    private string mensagem = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await CarregarEntidadeAsync();
    }

    private async Task CarregarEntidadeAsync()
    {
        using var conn = new SqliteConnection(ConexaoDB.ConnectionString);
        await conn.OpenAsync();

        var cmd = new SqliteCommand("SELECT Id, Nome, NomeFantasia, CNPJ, Presidente, Tesoureiro, Telefone, Email, Cidade FROM Entidade ORDER BY Id DESC LIMIT 1", conn);

        using var reader = await cmd.ExecuteReaderAsync();
        if (await reader.ReadAsync())
        {
            entidade = new Entidade
            {
                Id = reader.GetInt32(0),
                Nome = reader.IsDBNull(1) ? string.Empty : reader.GetString(1),
                NomeFantasia = reader.IsDBNull(2) ? string.Empty : reader.GetString(2),
                CNPJ = reader.IsDBNull(3) ? string.Empty : reader.GetString(3),
                Presidente = reader.IsDBNull(4) ? string.Empty : reader.GetString(4),
                Tesoureiro = reader.IsDBNull(5) ? string.Empty : reader.GetString(5),
                Telefone = reader.IsDBNull(6) ? string.Empty : reader.GetString(6),
                Email = reader.IsDBNull(7) ? string.Empty : reader.GetString(7),
                Cidade = reader.IsDBNull(8) ? string.Empty : reader.GetString(8)
            };
        }
    }

    private async Task Salvar()
    {
        if (string.IsNullOrWhiteSpace(entidade.Nome))
        {
            mensagem = "Informe o nome da entidade.";
            return;
        }

        using var conn = new SqliteConnection(ConexaoDB.ConnectionString);
        await conn.OpenAsync();

        if (entidade.Id > 0)
        {
            var cmd = new SqliteCommand(@"
                UPDATE Entidade SET Nome=@Nome, NomeFantasia=@NomeFantasia, CNPJ=@CNPJ, Presidente=@Presidente,
                Tesoureiro=@Tesoureiro, Telefone=@Telefone, Email=@Email, Cidade=@Cidade
                WHERE Id=@Id", conn);

            cmd.Parameters.AddWithValue("@Id", entidade.Id);
            cmd.Parameters.AddWithValue("@Nome", entidade.Nome);
            cmd.Parameters.AddWithValue("@NomeFantasia", entidade.NomeFantasia ?? string.Empty);
            cmd.Parameters.AddWithValue("@CNPJ", entidade.CNPJ ?? string.Empty);
            cmd.Parameters.AddWithValue("@Presidente", entidade.Presidente ?? string.Empty);
            cmd.Parameters.AddWithValue("@Tesoureiro", entidade.Tesoureiro ?? string.Empty);
            cmd.Parameters.AddWithValue("@Telefone", entidade.Telefone ?? string.Empty);
            cmd.Parameters.AddWithValue("@Email", entidade.Email ?? string.Empty);
            cmd.Parameters.AddWithValue("@Cidade", entidade.Cidade ?? string.Empty);
            await cmd.ExecuteNonQueryAsync();
        }
        else
        {
            var cmd = new SqliteCommand(@"
                INSERT INTO Entidade (Nome, NomeFantasia, CNPJ, Presidente, Tesoureiro, Telefone, Email, Cidade)
                VALUES (@Nome, @NomeFantasia, @CNPJ, @Presidente, @Tesoureiro, @Telefone, @Email, @Cidade)", conn);

            cmd.Parameters.AddWithValue("@Nome", entidade.Nome);
            cmd.Parameters.AddWithValue("@NomeFantasia", entidade.NomeFantasia ?? string.Empty);
            cmd.Parameters.AddWithValue("@CNPJ", entidade.CNPJ ?? string.Empty);
            cmd.Parameters.AddWithValue("@Presidente", entidade.Presidente ?? string.Empty);
            cmd.Parameters.AddWithValue("@Tesoureiro", entidade.Tesoureiro ?? string.Empty);
            cmd.Parameters.AddWithValue("@Telefone", entidade.Telefone ?? string.Empty);
            cmd.Parameters.AddWithValue("@Email", entidade.Email ?? string.Empty);
            cmd.Parameters.AddWithValue("@Cidade", entidade.Cidade ?? string.Empty);
            await cmd.ExecuteNonQueryAsync();
        }

        mensagem = "✅ Dados da entidade salvos com sucesso!";
        await CarregarEntidadeAsync();
    }
}
